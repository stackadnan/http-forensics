{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTTP Forensics case, schema_version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "question", "category", "tags", "protocol", "clients", "servers", "environment", "reproduce"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-\\d{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "category": { "enum": ["redirects", "cookies", "caching", "headers", "requests", "responses"] },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" } },
    "protocol": { "type": "array", "minItems": 1, "items": { "enum": ["http/1.0", "http/1.1"] } },
    "clients": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "servers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "environment": {
      "type": "object",
      "required": ["requires"],
      "properties": { "requires": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
    },
    "reproduce": { "type": "string", "minLength": 1 },
    "expected": { "type": "string", "minLength": 1 }
  }
}
